# =============================================================
# JH TEAM — .gitignore
# =============================================================

# Dependências
node_modules/
.pnp
.pnp.js

# Build outputs
.next/
dist/
out/
build/

# Turbo cache
.turbo/

# Variáveis de ambiente — NUNCA commitar valores reais
# (.env.example é versionado de propósito; o padrão ".env" não o afeta)
.env
.env.local
.env.*.local
.env.production

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# macOS
.DS_Store
*.pem

# IDE
.idea/
.vscode/settings.json

# Supabase local dev
supabase/.branches
supabase/.temp

# Backups locais (dumps de schema pré-migração) — NUNCA commitar
backups/

# Claude Code — estado runtime de agentes (local, por-desenvolvedor)
.claude/agent-memory/
