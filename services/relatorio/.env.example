# =============================================================
# JH TEAM — Serviço de Relatório Diário (Railway)
# Copie para .env e preencha. NUNCA commite o .env com valores reais.
# =============================================================

# -------------------------------------------------------------
# Supabase (OBRIGATÓRIO)
# Mesmo projeto do app web. A service_role bypassa RLS — só backend.
# -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -------------------------------------------------------------
# WhatsApp Business API — Meta Cloud API (OPCIONAL)
# Sem estas 3 chaves, o serviço apenas imprime o relatório no log
# (útil para validar o conteúdo antes de ligar o envio).
# Onde encontrar: Meta for Developers → WhatsApp → API Setup
# -------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Número do João em formato internacional, só dígitos. Ex.: 5511999999999
WHATSAPP_RECIPIENT=
# Versão da Graph API (padrão v21.0)
WHATSAPP_API_VERSION=v21.0

# -------------------------------------------------------------
# Agendamento (OPCIONAL — usados no modo --scheduler)
# REPORT_CRON em sintaxe cron; REPORT_TIMEZONE define o fuso do disparo.
# Padrão: 08:00 todos os dias no horário de Brasília.
# -------------------------------------------------------------
REPORT_CRON=0 8 * * *
REPORT_TIMEZONE=America/Sao_Paulo
