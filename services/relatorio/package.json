{
  "name": "@jh-team/relatorio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ts-node src/index.ts --once --dry",
    "build": "tsc",
    "start": "node dist/index.js --once",
    "start:scheduler": "node dist/index.js --scheduler",
    "report:once": "node dist/index.js --once",
    "report:dry": "ts-node src/index.ts --once --dry",
    "smoke": "ts-node src/smoke.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "dotenv": "^16.4.5",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "@types/node": "^22.15.3",
    "@types/node-cron": "^3.0.11",
    "ts-node": "^10.9.2"
  }
}
