# =============================================================
# JH TEAM — Variáveis de Ambiente
# =============================================================
# Copie este arquivo para .env.local e preencha os valores reais.
# NUNCA commite o arquivo .env.local com valores reais.
# Este arquivo (.env.example) é seguro para commitar.
# =============================================================

# -------------------------------------------------------------
# Supabase — Configuração do projeto
# Onde encontrar: Supabase Dashboard → Project Settings → API
# URL: https://supabase.com/dashboard/project/{seu-project-ref}/settings/api
# -------------------------------------------------------------

# URL pública do projeto Supabase (seguro para expor no browser)
# Formato: https://{project-ref}.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co

# Chave anônima do Supabase (seguro para expor no browser)
# Respeita as políticas RLS — use para operações autenticadas do cliente
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Chave de service_role do Supabase
# ATENÇÃO: NUNCA expor no browser ou em código client-side
# Bypassa TODAS as políticas RLS — usar apenas em:
#   - Route Handlers (Next.js API routes)
#   - Webhooks recebidos do Make
#   - Serviço de relatório (Railway)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -------------------------------------------------------------
# Segurança dos Webhooks (Make → Plataforma)
# Valida que a requisição veio realmente do Make e não de um terceiro
# Gere um valor forte: openssl rand -hex 32
# Configure o mesmo valor no Make como header: X-Webhook-Secret
# -------------------------------------------------------------
WEBHOOK_SECRET=gere_um_valor_aleatorio_forte_com_openssl_rand_hex_32

# -------------------------------------------------------------
# Ambiente
# -------------------------------------------------------------
NODE_ENV=development
